  {
    "id": "c3f0d001",
    "type": "inject",
    "z": "c3f0a001",
    "name": "Demo (clique — varia valores)",
    "props": [
      {
        "p": "payload",
        "v": "{}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 160,
    "y": 280,
    "wires": [["c3f0d002"]]
  },
  {
    "id": "c3f0d002",
    "type": "function",
    "z": "c3f0a001",
    "name": "demo aleatório",
    "func": "// Cada clique gera valores diferentes (gráfico não fica reta)\nmsg.payload = {\n    ts: Date.now(),\n    temp: +(36 + Math.random() * 2.8).toFixed(1),\n    hum: +(48 + Math.random() * 18).toFixed(1),\n    bpm: Math.floor(72 + Math.random() * 38),\n    alert: 0,\n    backlog: 0\n};\nif (msg.payload.temp > 38 || msg.payload.bpm > 120) {\n    msg.payload.alert = 1;\n}\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 300,
    "y": 280,
    "wires": [["c3f0f001"]]
  },
  {
    "id": "c3f0c001",
    "type": "mqtt in",
    "z": "c3f0a001",
    "name": "vitals JSON",
    "topic": "cardioia/esp32_01/vitals",
    "qos": "0",
    "datatype": "json",
    "broker": "c3f0b001",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 200,
    "wires": [["c3f0f001"]]
  },
  {
    "id": "c3f0f001",
    "type": "function",
    "z": "c3f0a001",
    "name": "rotear vitais",
    "func": "const p = msg.payload;\nconst t = Number(p.temp);\nconst h = Number(p.hum);\nconst b = Number(p.bpm);\nconst devAlert = Number(p.alert) === 1;\nconst m1 = { payload: t };\nconst m2 = { payload: h };\nconst m3 = {\n    payload: b,\n    devAlert,\n    temp: t,\n    bpm: b\n};\nreturn [ m1, m2, m3 ];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 200,
    "wires": [
      ["c3f0j001"],
      ["c3f0k001"],
      ["c3f0f002"]
    ]
  },
  {
    "id": "c3f0f002",
    "type": "function",
    "z": "c3f0a001",
    "name": "alertas",
    "func": "const overTemp = Number(msg.temp) > 38;\nconst overBpm = Number(msg.bpm) > 120;\nconst a = msg.devAlert || overTemp || overBpm;\nconst line = 'Temp ' + msg.temp + ' °C | BPM ' + msg.bpm;\nmsg.payload = a\n    ? ('ALERTA (' + line + '): limiar ou flag do dispositivo')\n    : ('OK (' + line + ')');\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 320,
    "wires": [["c3f0l001"]]
  },
