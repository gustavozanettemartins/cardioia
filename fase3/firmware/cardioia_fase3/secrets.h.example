/**
 * Copie este arquivo para secrets.h e preencha (secrets.h está no .gitignore).
 * Sem secrets.h válido, o firmware usa apenas Wi-Fi simulada e não conecta ao broker.
 */
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID "sua-rede-wifi"
#define WIFI_PASSWORD "sua-senha-wifi"

/** Host do HiveMQ Cloud (ex.: xxxxx.s1.eu.hivemq.cloud) */
#define MQTT_HOST "xxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883
#define MQTT_USER "seu-usuario-mqtt"
#define MQTT_PASSWORD "sua-senha-mqtt"

#endif
